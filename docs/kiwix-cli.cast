[0.001, "o", "5;12;49mProfessional wrestling\u001b[24m\u001b[38;5;7;49m                                                                                                                                                       \u001b[26;2H* \u001b[4m\u001b[38;5;12;49mPuppetry\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                     \u001b[27;2H* \u001b[4m\u001b[38;5;12;49mSpeech\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                       \u001b[28;2H* \u001b[4m\u001b[38;5;12;49mStand-up comedy\u001b[24m\u001b[38;5;7;49m                                                                                                                                                              \u001b[29;2H* \u001b[4m\u001b[38;5;12;49mStreet performance\u001b[24m\u001b[38;5;7;49m                                                                                                                                                           \u001b[30;2H* \u001b[4m\u001b[38;5;12;49mTheatre\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                      \u001b[31;2H* \u001b[4m\u001b[38;5;12;49mVentriloquism\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                \u001b[32;2H───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[33;2H\u001b[1m\u001b[4m\u001b[38;5;13;49m[image] AerialShowgirlsTissu1.jpg\u001b[22m\u001b[24m\u001b[38;5;7;49mA \u001b[4m\u001b[38;5;12;49mshowgirl\u001b[24m\u001b[38;5;7;49m performing \u001b[4m\u001b[38;5;12;49maerial silk\u001b[35;2H\u001b[24m\u001b[1m\u001b[38;5;15;49mAcrobatics\u001b[22m\u001b[38;5;7;49m (from \u001b[4m\u001b[38;5;12;49mAncient Greek\u001b[24m\u001b[38;5;7;49m \u001b[4m\u001b[38;5;12;49mἀκροβατέω\u001b[24m\u001b[3m\u001b[38;5;11;49m (akrobatéō)\u001b[23m\u001b[38;5;7;49m 'walk on tiptoe, strut')^{\u001b[4m\u001b[38;5;12;49m[1]\u001b[24m\u001b[38;5;7;49m} is the performance of human feats of \u001b[4m\u001b[38;5;12;49mbalance\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49magility\u001b[24m\u001b[38;5;7;49m, and \u001b[4m\u001b[38;5;12;49mmotor coordination\u001b[24m\u001b[38;5;7;49m. Acrobatic\u001b[36;2Hskills are used in \u001b[4m\u001b[38;5;12;49mperforming arts\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49msporting\u001b[24m\u001b[38;5;7;49m events, and \u001b[4m\u001b[38;5;12;49mmartial arts\u001b[24m\u001b[38;5;7;49m. Extensive use of acrobatic skills are most often performed in \u001b[4m\u001b[38;5;12;49macro dance\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mcircus\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mgymnastics\u001b[24m\u001b[38;5;7;49m, and\u001b[37;2H\u001b[4m\u001b[38;5;12;49mfreerunning\u001b[24m"]
[0.000, "o", "\u001b[38;5;7;49m and to a lesser extent in other athletic activities including \u001b[4m\u001b[38;5;12;49mballet\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mslacklining\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49mdiving\u001b[24m\u001b[38;5;7;49m. Although acrobatics is most commonly associated with human body\u001b[38;2Hperformance, the term is used to describe other types of performance, such as \u001b[4m\u001b[38;5;12;49maerobatics\u001b[24m\u001b[38;5;7;49m.\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
