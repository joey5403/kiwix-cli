[0.134, "o", "\u001b[2;1H\u001b[38;5;8;49m Ready\u001b[39;49m             \u001b[4;2H\u001b[1m\u001b[38;5;14;49m# Computer science\u001b[6;2H\u001b[22m\u001b[38;5;7;49mFor other uses, see \u001b[4m\u001b[38;5;12;49mComputer science (disambiguation)\u001b[24m\u001b[38;5;7;49m.\u001b[9;2HFundamental areas of computer science\u001b[10;2H\u001b[1m\u001b[4m\u001b[38;5;13;49m[image] Expression for Church numerals in lambda calculus\u001b[11;2H\u001b[22m\u001b[38;5;12;49mProgramming language theory\u001b[12;2H\u001b[1m\u001b[38;5;13;49m[image] Half-adder circuit\u001b[13;2H\u001b[22m\u001b[38;5;12;49mComputer architecture\u001b[14;2H\u001b[1m\u001b[38;5;13;49m[image] Example of an artificial neural network\u001b[15;2H\u001b[22m\u001b[38;5;12;49mArtificial intelligence\u001b[16;2H\u001b[1m\u001b[38;5;13;49m[image] Plot of a quicksort algorithm\u001b[17;2H\u001b[22m\u001b[38;5;12;49mComputational complexity theory\u001b[19;2H\u001b[24m\u001b[38;5;7;49m───────────────────────────────────────────────\u001b[20;2HComputer science                               \u001b[21;2H───────────────────────────────────────────────\u001b[22;2H\u001b[1m\u001b[4m\u001b[38;5;13;49m[image] Flowchart_structured_programming.svg.png\u001b[22m\u001b[24m\u001b[38;5;7;49m       \u001b[23;2H───────────────────────────────────────────────\u001b[24;2H* \u001b[4m\u001b[38;5;12;49mHistory\u001b[24m\u001b[38;5;7;49m                                      \u001b[25;2H* \u001b[4m\u001b[38;5;12;49mOutline\u001b[24m\u001b[38;5;7;49m                                      \u001b[26;2H* \u001b[4m\u001b[38;5;12;49mGlossary\u001b[24m\u001b[38;5;7;49m                                     \u001b[27;2H* Category                                     \u001b[28;2H───────────────────────────────────────────────\u001b[30;2H\u001b[1m\u001b[38;5;15;49mComputer science\u001b[22m\u001b[38;5;7;49m is the study of \u001b[4m\u001b[38;5;12;49mcomputation\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49minformation\u001b[24m\u001b[38;5;7;49m, and \u001b[4m\u001b[38;5;12;49mautomation\u001b[24m\u001b[38;5;7;49m.^{\u001b[4m\u001b[38;5;12;49m[1]\u001b[24m\u001b[38;5;7;49m}^{\u001b[4m\u001b[38;5;12;49m[2]\u001b[24m\u001b[38;5;7;49m}^{\u001b[4m\u001b[38;5;12;49m[3]\u001b[24m\u001b[38;5;7;49m} Included broadly in \u001b[4m\u001b[38;5;12;49mthe sciences\u001b[24m\u001b[38;5;7;49m, computer science spans \u001b[4m\u001b[38;5;12;49mtheoretical disciplines\u001b[31;2H\u001b[24m\u001b[38;5;7;49m(such as \u001b[4m\u001b[38;5;12;49malgorithms\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mtheory of computation\u001b[24m\u001b[38;5;7;49m, and \u001b[4m\u001b[38;5;12;49minformation theory\u001b[24m\u001b[38;5;7;49m) to \u001b[4m\u001b[38;5;12;49mapplied disciplines\u001b[24m\u001b[38;5;7;49m (including the design and implementation of \u001b[4m\u001b[38;5;12;49mhardware\u001b[24m\u001b[38;5;7;49m and\u001b[32;2H\u001b[4m\u001b[38;5;12;49msoftware\u001b[24m\u001b[38;5;7;49m).^{\u001b[4m\u001b[38;5;12;49m[4]\u001b[24m\u001b[38;5;7;49m}^{\u001b[4m\u001b[38;5;12;49m[5]\u001b[24m\u001b[38;5;7;49m}^{\u001b[4m\u001b[38;5;12;49m[6]\u001b[24m\u001b[38;5;7;49m} An expert in the field is known as a \u001b[4m\u001b[38;5;12;49mcomputer scientist\u001b[24m\u001b[38;5;7;49m.\u001b[34;2HAlgorithms and \u001b[4m\u001b[38;5;12;49mdata structures\u001b[24m\u001b[38;5;7;49m are central to computer science.^{\u001b[4m\u001b[38;5;12;49m[7]\u001b[24m\u001b[38;5;7;49m} The theory of computation concerns abstract \u001b[4m\u001b[38;5;12;49mmodels of computation\u001b[24m\u001b[38;5;7;49m and general classes of \u001b[4m\u001b[38;5;12;49mproblems\u001b[24m\u001b[38;5;7;49m that\u001b[35;2Hcan be solved using them. The fields of \u001b[4m\u001b[38;5;12;49mcryptography\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49mcomputer security\u001b[24m\u001b[38;5;7;49m involve studying the means for secure communication and preventing \u001b[4m\u001b[38;5;12;49msecurity vulnerabilities\u001b[24m\u001b[38;5;7;49m.\u001b[36;2H\u001b[4m\u001b[38;5;12;49mComputer graphics\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49mcomputational geometry\u001b[24m\u001b[38;5;7;49m address the generation of images. \u001b[4m\u001b[38;5;12;49mProgramming language theory\u001b[24m\u001b[38;5;7;49m considers different ways to describe computational processes, and\u001b[37;2H\u001b[4m\u001b[38;5;12;49mdatabase\u001b[24m\u001b[38;5;7;49m theory concerns the management of repositories of data. \u001b[4m\u001b[38;5;12;49mHuman–computer interaction\u001b[24m\u001b[38;5;7;49m investigates the interfaces through which humans and computers interact, and\u001b[38;2Hsoftware engineering focuses on the design and principles behind developing software. Areas such as \u001b[4m"]
[0.000, "o", "\u001b[38;5;12;49moperating systems\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mnetworks\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49membedded systems\u001b[24m\u001b[38;5;7;49m investigate the principles\u001b[39;2Hand design behind \u001b[4m\u001b[38;5;12;49mcomplex systems\u001b[24m\u001b[38;5;7;49m. Computer architecture describes the construction of computer components and computer-operated equipment. \u001b[4m\u001b[38;5;12;49mArtificial intelligence\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49mmachine\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
