[0.000, "o", "                                                            \u001b[27;2H* \u001b[4m\u001b[38;5;12;49mOpera\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                        \u001b[28;2H* \u001b[4m\u001b[38;5;12;49mProfessional wrestling\u001b[24m\u001b[38;5;7;49m                                                                                                                                                       \u001b[29;2H* \u001b[4m\u001b[38;5;12;49mPuppetry\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                     \u001b[30;2H* \u001b[4m\u001b[38;5;12;49mSpeech\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                       \u001b[31;2H* \u001b[4m\u001b[38;5;12;49mStand-up comedy\u001b[24m\u001b[38;5;7;49m                                                                                                                                                              \u001b[32;2H* \u001b[4m\u001b[38;5;12;49mStreet performance\u001b[24m\u001b[38;5;7;49m                                                                                                                                                           \u001b[33;2H* \u001b[4m\u001b[38;5;12;49mTheatre\u001b[24m\u001b[38;5;7;49m                                                                                                                                                                      \u001b[34;2H* \u001b[4m\u001b[38;5;12;49mVentriloquism\u001b[24m\u001b[38;5;7;49m                                                                                                                                                              