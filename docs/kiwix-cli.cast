[0.311, "o", "\u001b[2;1H\u001b[38;5;8;49m Ready\u001b[39;49m             \u001b[4;2H\u001b[1m\u001b[38;5;14;49m# Physical comedy\u001b[22m\u001b[39;49m \u001b[6;2H\u001b[1m\u001b[4m\u001b[38;5;13;49m[image] Chaplin_-_Modern_Times.jpg\u001b[22m\u001b[24m\u001b[38;5;7;49mAn example of physical comedy as \u001b[4m\u001b[38;5;12;49mCharlie Chaplin\u001b[24m\u001b[38;5;7;49m wrestles with factory controls in his 1936 comedy \u001b[3m\u001b[4m\u001b[38;5;12;49mModern Times\u001b[8;2H\u001b[23m\u001b[24m\u001b[1m\u001b[38;5;15;49mPhysical comedy\u001b[22m\u001b[38;5;7;49m is a form of \u001b[4m\u001b[38;5;12;49mcomedy\u001b[24m\u001b[38;5;7;49m focused on manipulation of the body for a humorous effect. It can include \u001b[4m\u001b[38;5;12;49mslapstick\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mclowning\u001b[24m\u001b[38;5;7;49m, \u001b[4m\u001b[38;5;12;49mmime\u001b[24m\u001b[38;5;7;49m, physical stunts, or making funny\u001b[9;2Hfaces.^{\u001b[4m\u001b[38;5;12;49m[1]\u001b[24m\u001b[38;5;7;49m}\u001b[11;2HPhysical comedy originated as part of the \u001b[4m\u001b[38;5;12;49mCommedia dell'arte\u001b[24m\u001b[38;5;7;49m.^{\u001b[4m\u001b[38;5;12;49m[2]\u001b[24m\u001b[38;5;7;49m} It is now sometimes incorporated into \u001b[4m\u001b[38;5;12;49msitcoms\u001b[24m\u001b[38;5;7;49m; for example, in the sitcom \u001b[3m\u001b[4m\u001b[38;5;12;"]
[0.000, "o", "49mThree's Company\u001b[23m\u001b[24m\u001b[38;5;7;49m, actor \u001b[4m\u001b[38;5;12;49mJohn\u001b[12;2HRitter\u001b[24m\u001b[38;5;7;49m frequently performed \u001b[3m\u001b[38;5;11;49mpratfalls\u001b[23m\u001b[38;5;7;49m. Cartoons, particularly film shorts, also commonly depict an exaggerated form of physical comedy (incorporating \u001b[4m\u001b[38;5;12;49mcartoon physics\u001b[24m\u001b[38;5;7;49m), such as\u001b[13;2Hin \u001b[3m\u001b[4m\u001b[38;5;12;49mTom and Jerry\u001b[23m\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49mWile E. Coyote and the Road Runner\u001b[24m\u001b[38;5;7;49m.^{\u001b[4m\u001b[38;5;12;49m[3]\u001b[24m\u001b[38;5;7;49m}\u001b[15;2H\u001b[1m\u001b[38;5;14;49m## Examples\u001b[17;2H\u001b[22m\u001b[4m\u001b[38;5;12;49mCharlie Chaplin\u001b[24m\u001b[38;5;7;49m started his film career as a physical comedian; although he developed additional means of comic expression, Chaplin's mature works continued to contain\u001b[18;2Helements of slapstick.\u001b[20;2HIn the movies, physical comedy is used by, for example,\u001b[21;2H* \u001b[4m\u001b[38;5;12;49mBuster Keaton\u001b[24m\u001b[38;5;7;49m as the eponymous character in \u001b[4m\u001b[38;5;12;49mSteamboat Bill, Jr.\u001b[24m\u001b[38;5;7;49m,\u001b[22;2H* \u001b[4m\u001b[38;5;12;49mJa"]
[0.000, "o", "cques Tati\u001b[24m\u001b[38;5;7;49m as \u001b[4m\u001b[38;5;12;49mMonsieur Hulot\u001b[24m\u001b[38;5;7;49m,\u001b[23;2H* \u001b[4m\u001b[38;5;12;49mPeter Sellers\u001b[24m\u001b[38;5;7;49m as \u001b[4m\u001b[38;5;12;49mChief Inspector Clouseau\u001b[24m\u001b[38;5;7;49m in \u001b[3m\u001b[4m\u001b[38;5;12;49mThe Pink Panther\u001b[23m\u001b[24m\u001b[38;5;7;49m film series,\u001b[24;2H* \u001b[4m\u001b[38;5;12;49mJackie Chan\u001b[24m\u001b[38;5;7;49m in many of his \u001b[4m\u001b[38;5;12;49mHong Kong action\u001b[24m\u001b[38;5;7;49m comedy films,^{\u001b[4m\u001b[38;5;12;49m[4]\u001b[24m\u001b[38;5;7;49m}\u001b[25;2H* \u001b[4m\u001b[38;5;12;49mZero Mostel\u001b[24m\u001b[38;5;7;49m's character Max Bialystock in \u001b[3m\u001b[4m\u001b[38;5;12;49mThe Producers\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[26;2H* \u001b[4m\u001b[38;5;12;49mBette Midler\u001b[24m\u001b[38;5;7;49m's, \u001b[4m\u001b[38;5;12;49mGoldie Hawn\u001b[24m\u001b[38;5;7;49m's and \u001b[4m\u001b[38;5;12;49mDiane Keaton\u001b[24m\u001b[38;5;7;49m's characters in \u001b[3m\u001b[4m\u001b[38;5;12;49mThe First Wives Club\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[27;2H* \u001b[4m\u001b[38;5;12;49mArnold Schwarzenegger\u001b[24m\u001b[38;5;7;49m's and \u001b[4m\u001b[38;5;12;49mDanny DeVito\u001b[24m\u001b[38;5;7;49m's characters in \u001b[3m\u001b[4m\u001b[38;5;12;49mTwins\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[28;2H* \u001b[4m"]
[0.001, "o", "\u001b[38;5;12;49mWill Ferrell\u001b[24m\u001b[38;5;7;49m's and \u001b[4m\u001b[38;5;12;49mJohn C. Reilly\u001b[24m\u001b[38;5;7;49m's characters in \u001b[3m\u001b[4m\u001b[38;5;12;49mStep Brothers\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[29;2H* \u001b[4m\u001b[38;5;12;49mZac Efron\u001b[24m\u001b[38;5;7;49m's and \u001b[4m\u001b[38;5;12;49mAdam DeVine\u001b[24m\u001b[38;5;7;49m's characters in \u001b[3m\u001b[4m\u001b[38;5;12;49mMike and Dave Need Wedding Dates\u001b[23m\u001b[24m\u001b[38;5;7;49m.\u001b[30;2H* \u001b[4m\u001b[38;5;12;49mSacha Baron Cohen\u001b[24m\u001b[38;5;7;49m's characters \u001b[4m\u001b[38;5;12;49mBorat Sagdiyev\u001b[24m\u001b[38;5;7;49m and \u001b[4m\u001b[38;5;12;49mBrüno Gehard\u001b[24m\u001b[38;5;7;49m in \u001b[3m\u001b[4m\u001b[38;5;12;49mBorat\u001b[23m\u001b[24m\u001b[38;5;7;49m (and its sequel \u001b[3m\u001b[4m\u001b[38;5;12;49mBorat Subsequent Moviefilm\u001b[23m\u001b[24m\u001b[38;5;7;49m) and \u001b[3m\u001b[4m\u001b[38;5;12;49mBrüno\u001b[23m\u001b[24m\u001b[38;5;7;49m.\u001b[31;2H* \u001b[4m\u001b[38;5;12;49mChris Farley\u001b[24m\u001b[38;5;7;49m's and \u001b[4m\u001b[38;5;12;49mDavid Spade\u001b[24m\u001b[38;5;7;49m's characters in \u001b[4m\u001b[38;5;12;49mTommy Boy\u001b[24m\u001b[38;5;7;49m,\u001b[32;2H* \u001b[4m\u001b[38;5;12;49mJim Carrey\u001b[24m\u001b[38;5;7;49m's character in \u001b[4m\u001b[38;5;12;49mLiar, Liar\u001b[24m\u001b[38;5;7;49m and mu"]
[0.000, "o", "ltiple other films.\u001b[34;2HIn television sitcoms, the use of physical comedy was seen in, for example,\u001b[35;2H* \u001b[4m\u001b[38;5;12;49mDick Van Dyke\u001b[24m\u001b[38;5;7;49m's character Rob Petrie in \u001b[3m\u001b[4m\u001b[38;5;12;49mThe Dick Van Dyke Show\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[36;2H* \u001b[4m\u001b[38;5;12;49mLucille Ball\u001b[24m\u001b[38;5;7;49m's character \u001b[4m\u001b[38;5;12;49mLucy Ricardo\u001b[24m\u001b[38;5;7;49m in \u001b[3m\u001b[4m\u001b[38;5;12;49mI Love Lucy\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[37;2H* \u001b[4m\u001b[38;5;12;49mMartin Lawrence\u001b[24m\u001b[38;5;7;49m's character Martin Payne in \u001b[3m\u001b[4m\u001b[38;5;12;49mMartin\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[38;2H* \u001b[4m\u001b[38;5;12;49mLarry Hagman\u001b[24m\u001b[38;5;7;49m's character Major Anthony Nelson in \u001b[3m\u001b[4m\u001b[38;5;12;49mI Dream of Jeannie\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[39;2H* \u001b[4m\u001b[38;5;12;49mJohn Ritter\u001b[24m\u001b[38;5;7;49m's character \u001b[4m\u001b[38;5;12;49mJack Tripper\u001b[24m\u001b[38;5;7;49m in \u001b[3m\u001b[4m\u001b[38;5;12;49mThree's Company\u001b[23m\u001b[24m\u001b[38;5;7;49m,\u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
